# Scoped API runtime only; never pass these to the worker or frontend.
# Server-only API runtime; inject secrets from Secret Manager. Keep local .env ignored.
OPENGEN_PUBLIC_URL=https://opengen.dev
# Dedicated sandbox restricted API key; intentionally empty.
STRIPE_SECRET_KEY=
# Backend endpoint signing secret, not an API key. Hosted delivery uses the exact-byte Vercel relay.
STRIPE_WEBHOOK_SECRET=
# Parse explicitly; reject values other than false/true. Default feature disabled.
STRIPE_LIVEMODE=false
# Stripe credentials alone cannot enable legacy funding. Review the complete binding first.
OPENGEN_BILLING_SANDBOX=false
OPENGEN_BILLING_MANUAL=false
OPENGEN_BILLING_CHECKOUT=paused
OPENGEN_BILLING_PROCESSOR_ENVIRONMENT=
OPENGEN_BILLING_PROCESSOR_ACCOUNT=
OPENGEN_BILLING_SANDBOX_WORKSPACE=
OPENGEN_BILLING_MANUAL_WORKSPACE=
OPENGEN_BILLING_APPROVAL_REFERENCE=
OPENGEN_BILLING_TERMS_VERSION=
OPENGEN_BILLING_TERMS_TEXT=
# Optional, dedicated installation operator authority; empty means triage is closed.
OPENGEN_BILLING_OPERATOR_BEARER=
# Sandbox activation also requires a separate sandbox database and nonproduction origin.
# Manual activation requires explicit live mode, approved owner/terms and a verified account.
# See billing/runtime-integration-026.md. No live activation is authorized by this template.
# GCP deployment uses pinned references, not these secret values, in OPENGEN_API_SECRET_BINDINGS:
# STRIPE_SECRET_KEY=opengen-stripe-key:1,STRIPE_WEBHOOK_SECRET=opengen-stripe-webhook-secret:1
# Only the API identity may access these secrets; references pin their versions. See DEPLOYMENT.md and infra/opengen.env.example.
