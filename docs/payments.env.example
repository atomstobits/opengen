# Scoped API runtime only; never pass these to the worker or frontend.
# Server-only API runtime; inject secrets from Secret Manager. Keep local .env ignored.
OPENGEN_PUBLIC_URL=https://opengen.dev
# Restricted Stripe API key; intentionally empty.
STRIPE_SECRET_KEY=
# Backend endpoint signing secret, not an API key. Hosted delivery uses the exact-byte Vercel relay.
STRIPE_WEBHOOK_SECRET=
# Parse explicitly; reject values other than false/true. Default feature disabled.
STRIPE_LIVEMODE=false
# Scoped payment bindings stay disabled until their separate review and qualification.
# For multi-tenant public self-serve launch (after live qualification): set STRIPE_LIVEMODE=true,
# OPENGEN_BILLING_MANUAL=true, OPENGEN_BILLING_CHECKOUT=open, OPENGEN_BILLING_RECHARGE=open,
# OPENGEN_BILLING_PUBLISHABLE_KEY=pk_live_..., optional OPENGEN_BILLING_PORTAL_CONFIGURATION=bpc_...,
# and leave OPENGEN_BILLING_MANUAL_WORKSPACE / OPENGEN_BILLING_APPROVAL_REFERENCE blank so verified
# workspace admins enroll or replace funding ownership self-serve.
OPENGEN_BILLING_SANDBOX=false
OPENGEN_BILLING_MANUAL=false
OPENGEN_BILLING_CHECKOUT=paused
OPENGEN_BILLING_RECHARGE=paused
OPENGEN_BILLING_PUBLISHABLE_KEY=
OPENGEN_BILLING_PORTAL_CONFIGURATION=
OPENGEN_BILLING_PROCESSOR_ENVIRONMENT=
OPENGEN_BILLING_PROCESSOR_ACCOUNT=
OPENGEN_BILLING_SANDBOX_WORKSPACE=
OPENGEN_BILLING_MANUAL_WORKSPACE=
OPENGEN_BILLING_APPROVAL_REFERENCE=
OPENGEN_BILLING_TERMS_VERSION=
OPENGEN_BILLING_TERMS_TEXT=
# Optional, dedicated installation operator authority; empty means triage is closed.
OPENGEN_BILLING_OPERATOR_BEARER=
# Sandbox activation also requires a separate sandbox database and nonproduction origin.
# Live activation requires explicit STRIPE_LIVEMODE=true, active human Terms receipts and a verified Stripe account.
# No live activation is authorized by this template.
# GCP deployment uses pinned references, not these secret values, in OPENGEN_API_SECRET_BINDINGS:
# STRIPE_SECRET_KEY=opengen-stripe-key:1,STRIPE_WEBHOOK_SECRET=opengen-stripe-webhook-secret:1,OPENGEN_BILLING_PUBLISHABLE_KEY=opengen-billing-publishable-key:1,OPENGEN_BILLING_PORTAL_CONFIGURATION=opengen-billing-portal-config:1,OPENGEN_BILLING_MANUAL=opengen-billing-manual:1,OPENGEN_BILLING_CHECKOUT=opengen-billing-checkout:1,OPENGEN_BILLING_RECHARGE=opengen-billing-recharge:1
# Only the API identity may access these secrets; references pin their versions. See DEPLOYMENT.md and infra/opengen.env.example.
