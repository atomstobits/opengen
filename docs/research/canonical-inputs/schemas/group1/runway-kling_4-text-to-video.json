{
  "checkedAt": "2026-11-03",
  "source": "https://docs.dev.runwayml.com/api/",
  "schema": {
    "type": "object",
    "properties": {
      "promptText": {
        "type": "string",
        "minLength": 1,
        "maxLength": 26000
      },
      "ratio": {
        "type": "string",
        "enum": [
          "1280:720",
          "720:1280",
          "940:940",
          "1460:624",
          "1920:1080",
          "1080:1920",
          "1440:1440",
          "2200:940",
          "auto_720p",
          "auto_1080p"
        ]
      },
      "duration": {
        "type": "integer",
        "minimum": 3,
        "maximum": 30
      },
      "references": {
        "minItems": 0,
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "uri": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 13,
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/.*"
                },
                {
                  "type": "string",
                  "minLength": 13,
                  "maxLength": 5000,
                  "pattern": "^runway:\\/\\/.*"
                },
                {
                  "type": "string",
                  "minLength": 13,
                  "maxLength": 5242880,
                  "pattern": "^data:image\\/.*"
                }
              ]
            }
          },
          "required": ["uri"],
          "additionalProperties": false
        }
      },
      "referenceVideos": {
        "minItems": 0,
        "maxItems": 5,
        "type": "array",
        "items": {}
      },
      "model": {
        "type": "string",
        "const": "kling_4"
      }
    },
    "required": ["promptText", "model"],
    "additionalProperties": false
  },
  "note": "Functional interface facts only; vendor descriptions and examples removed. No generation was executed."
}
