# Copy to .env; never commit real tokens or upstream credentials.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://opengen:replace-with-local-password@127.0.0.1:5432/opengen
MR_API_TOKEN=
# Random local crypto material is created by setup:local; never share it.
MR_VAULT_KEY=
MR_SESSION_SECRET=
MR_WORKSPACE_ID=local
MR_INITIAL_BALANCE_MICROS=0
# Shared API/worker control. Sandbox mode and the reserved sandbox database
# namespace force this off; use false for other payment-only qualification.
OPENGEN_PROVIDER_EXECUTION_ENABLED=true
METRICS_ORIGIN_REGION=undisclosed
MEDIA_ROUTER_API_URL=http://127.0.0.1:4310
OPENGEN_PUBLIC_URL=http://127.0.0.1:4320

# Optional server-only Vercel -> IAM-private Cloud Run identity transport.
# Leave both blank for local/Compose use. MEDIA_ROUTER_API_URL must be the
# canonical HTTPS *.run.app service origin when these are configured.
# Public resource identifiers only; the SDK obtains short-lived Vercel identity.
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=

# Credentials are tied to ONE Alibaba region. Additional regions can use
# ALIBABA_AP_SOUTHEAST_1_API_KEY / ALIBABA_AP_SOUTHEAST_1_WORKSPACE_ID, etc.
ALIBABA_REGION=ap-southeast-1
DASHSCOPE_API_KEY=
ALIBABA_WORKSPACE_ID=

# BytePlus Singapore ModelArk image endpoint. No key is sent to the browser.
BYTEPLUS_API_KEY=

# Additional providers, enabled only for documented compatible routes.
FAL_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

MINIMAX_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
RUNWAYML_API_SECRET=
PIKA_API_KEY=
FAL_END_USER_ID=

# Optional OpenID Connect for browser sign-in. Secrets stay in the API only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional OAuth for remote agents; audience is the canonical public /mcp URL.
OIDC_JWKS_URI=
OIDC_API_AUDIENCE=
# Default external bearer permissions; admin scopes require deliberate issuer and deployment grants.
OIDC_ALLOWED_SCOPES="read generate"
# Optional hosted legal publication snapshot for https://opengen.dev only.
# Leave both unset on local and self-hosted deployments to keep review-draft notices non-binding.
# OPENGEN_LEGAL_PUBLICATION_FILE=
# OPENGEN_LEGAL_PUBLICATION_JSON=

# Optional prepaid top-ups. API runtime only; never supply these to Vercel/client builds.
# Use a dedicated Stripe sandbox and configure its signed webhook before enabling.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=false
# Scoped payment bindings stay disabled until their separate review and qualification.
OPENGEN_BILLING_SANDBOX=false
OPENGEN_BILLING_MANUAL=false
OPENGEN_BILLING_CHECKOUT=paused
OPENGEN_BILLING_PROCESSOR_ENVIRONMENT=
OPENGEN_BILLING_PROCESSOR_ACCOUNT=
OPENGEN_BILLING_SANDBOX_WORKSPACE=
OPENGEN_BILLING_MANUAL_WORKSPACE=
OPENGEN_BILLING_APPROVAL_REFERENCE=
OPENGEN_BILLING_TERMS_VERSION=
OPENGEN_BILLING_TERMS_TEXT=
# Optional, separate installation operator secret; empty keeps billing triage closed.
OPENGEN_BILLING_OPERATOR_BEARER=

# Optional S3-compatible private asset storage. Never use NEXT_PUBLIC_ for these.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional trusted, externally network-isolated C2PA verifier in the worker.
C2PA_TOOL_PATH=
C2PA_TOOL_NETWORK_ISOLATED=false
C2PA_TRUST_ANCHORS_PATH=
C2PA_TSA_TRUST_ANCHORS_PATH=

# One finished Hyperframe hero clip and its poster; these URLs are public.
OPENGEN_HERO_VIDEO_URL=
OPENGEN_HERO_POSTER_URL=

# Private ready-input lifetime in milliseconds; blank means no automatic expiry.
# Accepted-job pins still protect retained bytes; never use an age-only inputs/ bucket rule.
MR_INPUT_RETENTION_MS=
# Optional operational email. Default blank sends nothing; requires verified member opt-in.
OPENGEN_NOTIFICATION_EMAIL_ENDPOINT=
OPENGEN_NOTIFICATION_EMAIL_AUTH_TOKEN=
# Enable only after qualifying durable relay deduplication for the same delivery ID/body.
OPENGEN_NOTIFICATION_EMAIL_IDEMPOTENCY_CONFIRMED=0
