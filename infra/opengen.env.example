# Public deployment identifiers only. Copy to infra/.local/opengen.env (Git ignored).
# Keep provider keys, database URLs/passwords and gateway tokens in Secret Manager.
OPENGEN_PROJECT_ID=your-opengen-project
OPENGEN_REGION=us-central1
OPENGEN_PUBLIC_URL=https://opengen.dev
# Nonsecret API/worker control. Set false for a dedicated payment sandbox.
# Omission defaults to true; explicit values must be exactly true or false.
OPENGEN_PROVIDER_EXECUTION_ENABLED=true
# Explicit nonsecret scope, identical on API and worker. This limits requests;
# it does not establish provider qualification or authorize activation.
# Self-hosters may explicitly select unrestricted after reviewing their routes.
OPENGEN_EXECUTION_SCOPE=qualification-sg-v1
# Optional reviewed first-frame content digest; leave unset to disable scoped I2V.
# OPENGEN_QUALIFICATION_FIRST_FRAME_SHA256=replace-with-reviewed-64-character-sha256
OPENGEN_API_IMAGE=us-central1-docker.pkg.dev/your-opengen-project/opengen/api@sha256:replace-with-digest
# Distinct identities with per-secret access; sharing one identity is rejected.
OPENGEN_API_RUNTIME_SA=opengen-api@your-opengen-project.iam.gserviceaccount.com
OPENGEN_WORKER_RUNTIME_SA=opengen-worker@your-opengen-project.iam.gserviceaccount.com
OPENGEN_CLOUDSQL_CONNECTION=your-opengen-project:us-central1:opengen-db
OPENGEN_DATABASE_SECRET=opengen-database-url
OPENGEN_API_TOKEN_SECRET=opengen-installation-token
OPENGEN_SECRET_VERSION=1
# Shared API/worker references: providers, MR_VAULT_KEY and private S3/AWS storage.
# References only; example: BYTEPLUS_API_KEY=byteplus-api-key:1,FAL_KEY=fal-key:1,MR_VAULT_KEY=opengen-vault-key:1
# Alibaba regional bindings use ALIBABA_<REGION>_{API_KEY,WORKSPACE_ID} across AP_SOUTHEAST_1, US_EAST_1, EU_CENTRAL_1, CN_HONGKONG, AP_NORTHEAST_1 and CN_BEIJING (bind CN_BEIJING only after Mainland real-name verification).
# Do not place MR_API_TOKEN, MR_SESSION_SECRET, OIDC_* or STRIPE_* here.
OPENGEN_PROVIDER_SECRET_BINDINGS=
# API-only references; never values. Optional account sign-in, hosted legal publication JSON and prepaid top-ups.
# Example: MR_SESSION_SECRET=opengen-session-secret:1,OIDC_ISSUER=opengen-oidc-issuer:1,OIDC_CLIENT_ID=opengen-oidc-client-id:1,OIDC_CLIENT_SECRET=opengen-oidc-client-secret:1
# Hosted legal example (https://opengen.dev only): OPENGEN_LEGAL_PUBLICATION_JSON=opengen-legal-publication:1
# Stripe example: STRIPE_SECRET_KEY=opengen-stripe-key:1,STRIPE_WEBHOOK_SECRET=opengen-stripe-webhook-secret:1
OPENGEN_API_SECRET_BINDINGS=
# Nonsecret API-only mode; default dedicated Stripe sandbox. No charges are enabled by planning.
STRIPE_LIVEMODE=false
# --apply additionally requires explicit operator acknowledgement after cost review.
OPENGEN_BILLABLE_RUNTIME_APPROVED=no

# Optional Vercel server-side configuration, not consumed by deploy-gcp.sh.
# Resource identifiers only. Set after creating/reviewing WIF and the private API.
# No provider/operator/database secrets or service-account JSON belong on Vercel.
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/your-pool/providers/your-provider
GCP_SERVICE_ACCOUNT_EMAIL=opengen-vercel@your-opengen-project.iam.gserviceaccount.com
MEDIA_ROUTER_API_URL=https://your-api-service.run.app
